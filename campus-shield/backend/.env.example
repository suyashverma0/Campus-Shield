# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection URI
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/campus_shield?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/campus_shield

# JWT Secret & Expiry
JWT_SECRET=super_secret_campus_shield_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# Existing Python FastAPI AI Service URL
AI_SERVICE_URL=http://127.0.0.1:8000
AI_SIMILARITY_THRESHOLD=0.5
AI_TOP_K=10

# Frontend Allowed Origin (for CORS)
FRONTEND_URL=http://localhost:5173

# File Upload Configuration
MAX_FILE_SIZE_MB=5
UPLOAD_DIR=uploads

# Cloudinary Storage (Optional Production Cloud Storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
